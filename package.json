{
  "name": "@petercjl/jqcli",
  "version": "0.1.1",
  "type": "module",
  "description": "JoinQuant strategy writing, validation and automated backtest lifecycle",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jqcli": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "capabilities.json",
    "jqcli",
    "pyproject.toml",
    "INSTALL.md",
    "UPDATE.md",
    "release-integrity.json",
    "scripts/install-notice.mjs",
    "scripts/release-identity.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check bin/cli.mjs",
    "postinstall": "node scripts/install-notice.mjs",
    "version": "node scripts/release-identity.mjs sync && git add capabilities.json skills/jqcli/capabilities.json pyproject.toml jqcli/__init__.py release-integrity.json",
    "prepack": "node scripts/release-identity.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petercjl/jqcli.git"
  },
  "quant": {
    "kind": "jqcli"
  },
  "agentPackage": {
    "kind": "cli-skill"
  }
}
